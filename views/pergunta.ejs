<%- include('partials/header.ejs'); %>
    <%- include('partials/navbar.ejs');%>
        <div class="container">
            <hr>
            <h2>
                <%= pergunta.titulo %>
            </h2>
            <p>
                <%= pergunta.descricao %>
            </p>
            <hr>
            <form method="POST" action="/responder">
                <h3>Responda</h3>
                <label class="mb-2">Resposta:</label>
                <textarea class="form-control mb-2" name="corpo" placeholder="Digite sua resposta!">
                </textarea>
                <input type="hidden" name="pergunta" value="<%= pergunta.id %>">
                <button type="submit" class="btn btn-primary">Responder</button>
            </form>

            <hr>
            <h3>Respostas</h3>
            <hr>
            <% respostas.forEach(resposta=>{%>
                <br>
                <div class="card">

                    <div class="card-body">
                        <%= resposta.corpo %>
                    </div>
                </div>
                <% }) %>
        </div>

        <%- include('partials/footer.ejs'); %>